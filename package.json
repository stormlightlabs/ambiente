{
  "name": "ambiente",
  "private": true,
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "format": "pnpm format:rust && pnpm format:web",
    "format:check": "pnpm format:rust:check && pnpm format:web:check",
    "format:rust": "cargo fmt --all",
    "format:rust:check": "cargo fmt --all -- --check",
    "format:web": "prettier --write .",
    "format:web:check": "prettier --check .",
    "lint": "pnpm lint:rust && pnpm lint:web",
    "lint:rust": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "lint:web": "eslint . --max-warnings=0",
    "test": "pnpm test:rust && pnpm test:web",
    "test:rust": "cargo test --workspace --all-features",
    "test:web": "vitest run --passWithNoTests",
    "check": "pnpm format:check && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
