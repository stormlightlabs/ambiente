{
	"name": "ambiente",
	"private": true,
	"packageManager": "pnpm@11.14.0",
	"engines": {
		"node": ">=24 <27",
		"pnpm": ">=11 <12"
	},
	"scripts": {
		"build:wasm": "pnpm --filter @ambiente/wasm build",
		"format": "pnpm format:rust && pnpm format:web",
		"format:check": "pnpm format:rust:check && pnpm format:web:check",
		"format:rust": "cargo fmt --all",
		"format:rust:check": "cargo fmt --all -- --check",
		"format:web": "prettier --write .",
		"format:web:check": "prettier --check .",
		"lint": "pnpm lint:rust && pnpm lint:web",
		"lint:rust": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
		"lint:web": "eslint . --max-warnings=0",
		"test": "pnpm test:rust && pnpm test:web",
		"test:rust": "cargo test --workspace --all-features",
		"test:wasm": "CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER=wasm-bindgen-test-runner cargo test --package ambiente-wasm --test conformance --target wasm32-unknown-unknown",
		"test:web": "pnpm build:wasm && pnpm --filter @ambiente/wasm test:types && pnpm --filter @ambiente/wasm test && pnpm --filter @ambiente/web test:types && pnpm --filter @ambiente/web test",
		"check": "pnpm format:check && pnpm lint && pnpm test"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@typescript-eslint/parser": "^8.68.0",
		"eslint": "^9.39.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-solid": "^0.16.1",
		"eslint-plugin-unicorn": "^63.0.0",
		"globals": "^16.5.0",
		"markdownlint-cli2": "^0.18.1",
		"prettier": "^3.6.2",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.41.0",
		"vitest": "^3.2.4"
	}
}
