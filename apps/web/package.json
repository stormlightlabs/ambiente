{
	"name": "@ambiente/web",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vike build && pagefind --site dist/client --output-subdir pagefind",
		"dev": "pnpm pagefind:dev && vike dev",
		"dev:plain": "vike dev",
		"pagefind:dev": "vike build && pagefind --site dist/client --output-path public/pagefind --quiet",
		"preview": "vike preview",
		"test": "pnpm test:unit && pnpm build && pnpm test:static && pnpm test:e2e",
		"test:e2e": "playwright test",
		"test:static": "vitest run tests/static-build.test.ts",
		"test:types": "tsc --noEmit",
		"test:unit": "vitest run tests/content.test.ts tests/facade.test.ts tests/scroll-spy.test.ts"
	},
	"dependencies": {
		"@ambiente/audio": "workspace:*",
		"@ambiente/wasm": "workspace:*",
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource-variable/literata": "^5.3.0",
		"satteri": "^0.10.5",
		"satteri-expressive-code": "^0.1.24",
		"solid-js": "^1.9.15",
		"vike": "^0.4.264",
		"vike-solid": "^0.8.4"
	},
	"devDependencies": {
		"@iconify-json/bi": "^1.2.7",
		"@iconify-json/ri": "^1.2.10",
		"@playwright/test": "^1.62.1",
		"@types/node": "^26.4.0",
		"jsdom": "^30.0.1",
		"pagefind": "^1.5.2",
		"unocss": "^66.8.1",
		"vite": "^7.3.6",
		"vite-plugin-satteri": "^0.3.5",
		"vite-plugin-solid": "^2.11.14"
	}
}
